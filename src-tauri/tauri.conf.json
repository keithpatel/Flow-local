{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowLocal",
  "version": "0.1.0",
  "identifier": "com.flowlocal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare_bundle_resources.js && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowLocal",
        "width": 1080,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "FlowLocal Overlay",
        "url": "index.html#/overlay",
        "width": 260,
        "height": 76,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
